---
const { Icon, name, description } = Astro.props;
---

<article
  class="flex max-w-full shrink-0 flex-col items-center gap-4 rounded-xl border border-transparent p-6 text-center [background:linear-gradient(var(--color-snow),var(--color-snow))_padding-box,linear-gradient(to_bottom,var(--color-lavender),var(--color-violet))_border-box]"
>
  <div class="flex size-[59px] items-center justify-center">
    <Icon aria-hidden="true" />
  </div>
  <h3 class="font-inter w-[128px] text-lg font-bold text-black">{name}</h3>
  <p class="font-lato w-[220px] max-w-full text-sm leading-[1.2] text-[#6e6e6e]">
    {description}
  </p>
</article>
